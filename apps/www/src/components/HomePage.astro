---
import Footer from "./Footer.astro";
import DownloadActions from "./DownloadActions.astro";
import GithubMark from "./GithubMark.astro";
import Header from "./Header.astro";
import Mascot from "./Mascot.astro";
import { ProductPreview } from "./ProductPreview";
import { AGENT_CATALOG, APP_CATALOG } from "@corvo/core";
import type { StoreCategory } from "../i18n/launch";
import type { Locale } from "../i18n/locales";
import { getLaunchCopy } from "../i18n/launch";
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, isLocale, localeHomePath } from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  DOWNLOAD_URL,
  DOWNLOAD_URL_LINUX,
  DOWNLOAD_URL_WINDOWS,
  GITHUB_URL,
  INSTALL_COMMAND,
  INSTALL_COMMAND_WINDOWS,
  SITE_URL,
} from "../site";
import { homeStructuredData } from "../structured-data";
import "../styles/launch.css";

const locale: Locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;

const copy = getLaunchCopy(locale);
const homeHref = localeHomePath(locale);
const pageUrl = `${SITE_URL}${homeHref === "/" ? "/" : homeHref}`;

const structuredData = homeStructuredData({
  pageUrl,
  title: copy.meta.title,
  description: copy.meta.description,
  inLanguage: LOCALE_HTML_LANG[locale],
  faq: copy.faq.items,
});

// Social images exist for these languages; the others borrow the English one until theirs is drawn.
const OG_LOCALES: readonly Locale[] = ["pt", "es", "fr", "de", "ja", "zh"];
const ogImage = OG_LOCALES.includes(locale) ? `/og-image-${locale}.png` : "/og-image.png";

const { works } = copy;

// The Store's agents and the apps come from the product's own catalogs, so the page says what is there.
const catalogLocale = locale === "pt" ? "pt-BR" : "en";
const CATEGORY_ORDER: StoreCategory[] = [
  "finance",
  "operations",
  "marketing",
  "development",
  "support",
  "sales",
  "design",
  "knowledge",
  "people",
];
const storeGroups = CATEGORY_ORDER.map((category) => ({
  category,
  names: AGENT_CATALOG.filter((entry) => entry.category === category).map(
    (entry) => entry.name[catalogLocale] ?? entry.name.en,
  ),
})).filter((group) => group.names.length > 0);
const appNames = APP_CATALOG.filter((app) => app.featured).map((app) => app.name).slice(0, 8);
// The rings show a Claude subscription at 34% of its 5 hour window and 58% of its week.
const RINGS = [
  { radius: 27, percent: 58 },
  { radius: 19, percent: 34 },
].map(({ radius, percent }) => ({ radius, length: 2 * Math.PI * radius, percent }));
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  {structuredData}
  locale={locale}
  skipLabel={copy.meta.skipToContent}
  homeAlternates
  ogImageAlt={copy.meta.ogImageAlt}
  ogImage={ogImage}
>
  <div class="container">
    <Header locale={locale} copy={copy.nav} homeHref={homeHref} />

    <main id="main">
      <section class="lp-hero">
        <div class="lp-hero__copy">
          <h1>
            {copy.hero.line1}
            <span class="lp-underline">{copy.hero.line2}</span>
          </h1>
          <p class="lead">{copy.hero.lead}</p>
          <DownloadActions
            class="lp-hero__actions"
            download={copy.cta.download}
            github={copy.hero.githubLabel}
            placement="hero"
          />
          <p class="download-note">
            {
              copy.hero.note.split(/(\{windows\}|\{linux\})/).map((part) =>
                part === "{windows}" ? (
                  <a href={DOWNLOAD_URL_WINDOWS} data-attr="hero-download-windows">Windows</a>
                ) : part === "{linux}" ? (
                  <a href={DOWNLOAD_URL_LINUX} data-attr="hero-download-linux">Linux</a>
                ) : (
                  part
                ),
              )
            }
          </p>
          <div class="lp-command lp-hero__command">
            <div>
              <code id="hero-install">{INSTALL_COMMAND}</code>
              <button type="button" data-copy="#hero-install" data-copied={copy.install.copiedLabel}>
                {copy.install.copyLabel}
              </button>
            </div>
          </div>
        </div>
        <div class="lp-hero__stage">
          <Mascot hue="menta" size={250} float interactive />
          {
            copy.hero.tags.map((tag, index) => (
              <div class={`lp-tag lp-tag--${index + 1}`}>
                <Mascot hue={tag.hue} size={34} />
                <span>
                  <b>{tag.name}</b>
                  {tag.role}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="agents" class="lp-agent" aria-labelledby="agent-heading">
        <div class="lp-agent__intro" data-reveal>
          <h2 id="agent-heading" class="lp-title">
            {copy.agent.heading}
            <span class="lp-accent">{copy.agent.accent}</span>
          </h2>
          <p>{copy.agent.copy}</p>
        </div>
        <ul class="lp-agent__traits" data-reveal>
          {
            copy.agent.traits.map((trait) => (
              <li>
                <h3>{trait.title}</h3>
                <p>{trait.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="demo" class="lp-live" aria-labelledby="live-heading">
        <div class="lp-live__head" data-reveal>
          <h2 id="live-heading" class="lp-title">
            {copy.team.heading}
            <span class="lp-accent">{copy.team.accent}</span>
          </h2>
          <p>{copy.team.copy}</p>
        </div>
        <div class="lp-live__stage" data-reveal>
          <ProductPreview copy={copy.preview} client:visible />
        </div>
      </section>

      <section id="store" class="lp-store" aria-labelledby="store-heading">
        <div class="lp-store__intro" data-reveal>
          <h2 id="store-heading" class="lp-title">
            {copy.store.heading}
            <span class="lp-accent">{copy.store.accent}</span>
          </h2>
          <p>{copy.store.copy}</p>
          <p class="lp-store__count">{copy.store.count.replace("{count}", String(AGENT_CATALOG.length))}</p>
        </div>
        <dl class="lp-store__groups" data-reveal>
          {
            storeGroups.map((group) => (
              <div>
                <dt>{copy.store.categories[group.category]}</dt>
                <dd>
                  {group.names.map((name) => (
                    <span>{name}</span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="features" class="lp-works" aria-labelledby="works-heading">
        <h2 id="works-heading" class="lp-title" data-reveal>
          {works.heading}
          <span class="lp-accent">{works.accent}</span>
        </h2>
        <div class="lp-bento">
          <article class="lp-card lp-card--routines" data-reveal>
            <h3>{works.cards[0].title}</h3>
            <p>{works.cards[0].body}</p>
            <ul class="lp-routines">
              {
                works.routines.map((routine) => (
                  <li>
                    <time>{routine.when}</time>
                    <span>{routine.what}</span>
                  </li>
                ))
              }
            </ul>
          </article>

          <article class="lp-card lp-card--computer" data-reveal>
            <h3>{works.cards[1].title}</h3>
            <p>{works.cards[1].body}</p>
            <div class="lp-term">
              <b>{works.computer.title}</b>
              {works.computer.lines.map((line) => <code>{line}</code>)}
            </div>
          </article>

          <article class="lp-card lp-card--models" data-reveal>
            <h3>{works.cards[2].title}</h3>
            <p>{works.cards[2].body}</p>
            <div class="lp-models">
              <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                {
                  RINGS.map((ring) => (
                    <>
                      <circle cx="32" cy="32" r={ring.radius} class="lp-ring__track" />
                      <circle
                        cx="32"
                        cy="32"
                        r={ring.radius}
                        class="lp-ring__fill"
                        stroke-dasharray={`${(ring.length * ring.percent) / 100} ${ring.length}`}
                        transform="rotate(-90 32 32)"
                      />
                    </>
                  ))
                }
              </svg>
              <ul>
                <li><b>{works.models.primary}</b></li>
                <li><span>{works.models.window5h}</span> 34%</li>
                <li><span>{works.models.weekly}</span> 58%</li>
                <li class="lp-models__reset">{works.models.resets}</li>
              </ul>
            </div>
            <p class="lp-models__local"><i class="lp-pill">{works.models.local}</i></p>
          </article>

          <article class="lp-card lp-card--usage" data-reveal>
            <h3>{works.cards[3].title}</h3>
            <p>{works.cards[3].body}</p>
            <div class="lp-usage">
              <b>{works.usage.title}</b>
              {
                works.usage.agents.map((agent) => (
                  <div class="lp-usage__row">
                    <Mascot hue={agent.hue} size={24} />
                    <span>{agent.name}</span>
                    <span class="lp-usage__bar"><i style={`width:${agent.share * 100}%`} /></span>
                    <span class="lp-usage__pct">{Math.round(agent.share * 100)}%</span>
                  </div>
                ))
              }
            </div>
          </article>

          <article class="lp-card lp-card--apps" data-reveal>
            <h3>{works.cards[4].title}</h3>
            <p>{works.cards[4].body}</p>
            <ul class="lp-chips">
              {appNames.map((name) => <li>{name}</li>)}
            </ul>
          </article>

          <article class="lp-card lp-card--reach" data-reveal>
            <div>
              <h3>{works.cards[5].title}</h3>
              <p>{works.cards[5].body}</p>
            </div>
            <ul class="lp-chips lp-chips--big">
              {works.reach.map((name) => <li>{name}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section id="open" class="lp-open" aria-labelledby="open-heading">
        <div class="lp-open__intro" data-reveal>
          <h2 id="open-heading" class="lp-title">
            {copy.open.heading}
            <span class="lp-accent">{copy.open.accent}</span>
          </h2>
          <p>{copy.open.copy}</p>
          <div class="lp-open__actions">
            <a class="button button--primary" href={GITHUB_URL} target="_blank" rel="noopener" data-attr="open-github">
              <GithubMark class="button__icon" />
              {copy.open.github}
            </a>
            <span class="lp-license">{copy.open.license}</span>
          </div>
        </div>
        <ul class="lp-open__points" data-reveal>
          {
            copy.open.points.map((point) => (
              <li>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="install" class="lp-install-section" aria-labelledby="install-heading">
        <div class="lp-install-section__intro" data-reveal>
          <h2 id="install-heading" class="lp-title">{copy.install.heading}</h2>
          <p>{copy.install.copy}</p>
          <a
            class="button button--primary"
            href={DOWNLOAD_URL}
            target="_blank"
            rel="noopener"
            data-attr="install-download"
          >
            {copy.install.download}
          </a>
        </div>
        <div class="lp-install-section__commands" data-reveal>
          <p class="lp-install-section__also">{copy.install.alsoFor}</p>
          <div class="lp-command">
            <span>{copy.install.macLinux}</span>
            <div>
              <code id="install-unix">{INSTALL_COMMAND}</code>
              <button type="button" data-copy="#install-unix" data-copied={copy.install.copiedLabel}>
                {copy.install.copyLabel}
              </button>
            </div>
          </div>
          <div class="lp-command">
            <span>{copy.install.windows}</span>
            <div>
              <code id="install-windows">{INSTALL_COMMAND_WINDOWS}</code>
              <button type="button" data-copy="#install-windows" data-copied={copy.install.copiedLabel}>
                {copy.install.copyLabel}
              </button>
            </div>
          </div>
          <p class="download-note">{copy.install.note}</p>
        </div>
      </section>

      <section id="faq" class="lp-faq" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="lp-title lp-title--small" data-reveal>{copy.faq.heading}</h2>
        <div class="home-faq" data-reveal>
          {
            copy.faq.items.map((item, index) => (
              <details name="faq" open={index === 0}>
                <summary>
                  <h3>{item.question}</h3>
                  <span class="home-faq__mark" aria-hidden="true" />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="lp-cta" aria-labelledby="cta-heading">
        <div data-reveal>
          <h2 id="cta-heading" class="lp-title">{copy.cta.heading}</h2>
          <p>{copy.cta.copy}</p>
          <DownloadActions
            class="lp-hero__actions"
            download={copy.cta.download}
            github={copy.cta.github}
            placement="cta"
          />
        </div>
        <div class="lp-cta__flock" aria-hidden="true">
          <Mascot hue="azul" size={64} />
          <Mascot hue="laranja" size={84} />
          <Mascot hue="menta" size={112} float />
          <Mascot hue="violeta" size={84} />
          <Mascot hue="rosa" size={64} />
        </div>
      </section>
    </main>

    <Footer locale={locale} homeHref={homeHref} />
  </div>
</BaseLayout>

<script>
  // Blocks below the fold rise once as they arrive. Hidden only after JS runs, so nothing is lost without it.
  const calm = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (calm && "IntersectionObserver" in window) {
    document.documentElement.classList.add("js-reveal");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
    );
    document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const target = document.querySelector(button.dataset.copy ?? "");
      if (!target?.textContent) return;
      try {
        await navigator.clipboard.writeText(target.textContent);
      } catch {
        return;
      }
      const label = button.textContent;
      button.textContent = button.dataset.copied ?? label;
      setTimeout(() => (button.textContent = label), 1600);
    });
  });
</script>
