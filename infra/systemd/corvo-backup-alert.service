[Unit]
Description=Notify operators when a production backup fails

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/corvo-host-alert backup-failure "Nightly backup failed. Inspect corvo-backup.service on the server."
StateDirectory=corvo/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/corvo/alerts
PrivateTmp=true
