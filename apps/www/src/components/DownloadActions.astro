---
import { DOWNLOAD_URL, GITHUB_URL } from "../site";
import GithubMark from "./GithubMark.astro";

type Props = {
  class: string;
  download: string;
  github: string;
  /** PostHog `data-attr` prefix that tells this placement apart from others. */
  placement: string;
};

const { class: className, download, github, placement } = Astro.props;
---

<div class={className}>
  <a
    class="button button--primary"
    href={DOWNLOAD_URL}
    target="_blank"
    rel="noopener"
    data-attr={`${placement}-download`}
  >
    <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.4 6.62 1.1 8.79.73 1.06 1.6 2.25 2.75 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.67-2.15.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.3-.88-2.32-3.53zM14.2 6.07c.6-.73 1.01-1.75.9-2.76-.87.04-1.92.58-2.54 1.3-.56.65-1.05 1.69-.92 2.68.97.07 1.96-.49 2.56-1.22z"
      ></path>
    </svg>
    {download}
  </a>
  <a
    class="button button--secondary"
    href={GITHUB_URL}
    target="_blank"
    rel="noopener"
    data-attr={`${placement}-github`}
  >
    <GithubMark class="button__icon" />
    {github}
  </a>
</div>
