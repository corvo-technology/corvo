---
import type { MascotHue } from "../mascot";
import { Chick } from "./Chick";

type Props = {
  hue: MascotHue;
  size: number;
  /** Lets the chick float gently. */
  float?: boolean;
  /** Its eyes follow the pointer and it smiles when pressed; hydrates this one chick. */
  interactive?: boolean;
  class?: string;
};

const { hue, size, float = false, interactive = false, class: className } = Astro.props;
---

<span
  class:list={["mascot", className]}
  style={`--s:${size}px`}
  data-float={float ? "" : undefined}
>
  {
    interactive ? (
      <Chick hue={hue} interactive client:load />
    ) : (
      <Chick hue={hue} />
    )
  }
</span>
