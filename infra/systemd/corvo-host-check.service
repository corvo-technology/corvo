[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/corvo/backup.env
ExecStart=/usr/local/sbin/corvo-host-check
StateDirectory=corvo/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/corvo/alerts
ProtectHome=true
PrivateTmp=true
