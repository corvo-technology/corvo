---
import type { GetStaticPaths } from "astro";
import Mascot from "../../components/Mascot.astro";
import { getLaunchCopy } from "../../i18n/launch";
import { LOCALES, LOCALE_HTML_LANG, isLocale } from "../../i18n/locales";

// The social image is drawn here and captured by scripts/generate-og.mjs, so it reads the same
// headline as the page. The route exists only in dev; production builds skip it.
export const getStaticPaths = (() =>
  import.meta.env.DEV ? LOCALES.map((locale) => ({ params: { locale } })) : []) satisfies GetStaticPaths;

const { locale } = Astro.params;
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`);

const copy = getLaunchCopy(locale);
const { line1, line2 } = copy.hero;
const [tag] = copy.hero.tags.slice(1);
// Long headlines step down so every language fits the same block.
const length = line1.length + line2.length;
const cjk = locale === "ja" || locale === "zh";
const size = cjk ? 44 : length <= 50 ? 68 : length <= 64 ? 60 : 52;
---

<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Rook social image</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main id="og" style={`--size:${size}px;--width:${cjk ? 620 : 660}px`}>
      <header>
        <Mascot hue="menta" size={46} />
        <span>Rook</span>
      </header>
      <h1>
        <span>{line1}</span>
        <span class="accent">{line2}</span>
      </h1>
      <p>{copy.meta.ogTagline}</p>
      <div class="stage" aria-hidden="true">
        <Mascot hue="menta" size={300} />
        {
          tag && (
            <div class="tag">
              <Mascot hue={tag.hue} size={40} />
              <span>
                <b>{tag.name}</b>
                {tag.role}
              </span>
            </div>
          )
        }
      </div>
    </main>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    background: #0b0b0c;
  }
  #og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: linear-gradient(180deg, #11231d 0%, #0b0b0c 62%);
    color: #f5f5f5;
    font-family: "Instrument Sans", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans", sans-serif;
  }
  /* The page loads no site styles, so a mascot takes its size from --s here. */
  #og .mascot {
    display: block;
    flex: none;
    width: var(--s);
    height: var(--s);
  }
  #og .mascot svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  #og header {
    position: absolute;
    top: 56px;
    left: 64px;
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  #og h1 {
    position: absolute;
    top: 168px;
    left: 64px;
    z-index: 1;
    width: var(--width);
    margin: 0;
    font-size: var(--size);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }
  #og h1 span {
    display: block;
  }
  #og h1 .accent {
    margin-top: 10px;
    color: #3fd6a8;
  }
  #og p {
    position: absolute;
    bottom: 60px;
    left: 64px;
    margin: 0;
    color: #a1a1a6;
    font-size: 30px;
    letter-spacing: -0.01em;
  }
  #og .stage {
    position: absolute;
    top: 150px;
    right: 90px;
    width: 340px;
  }
  #og .stage > .mascot {
    filter: drop-shadow(0 28px 40px rgb(0 0 0 / 0.5));
  }
  #og .tag {
    position: absolute;
    top: -34px;
    left: -110px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px 12px 12px;
    border: 1px solid #2a2a2e;
    border-radius: 16px;
    background: #151517;
    box-shadow: 0 14px 30px rgb(0 0 0 / 0.45);
    font-size: 20px;
    line-height: 1.2;
    color: #a1a1a6;
  }
  #og .tag b {
    display: block;
    color: #f5f5f5;
    font-weight: 600;
  }
  #og .tag .mascot {
    border-radius: 10px;
    filter: none;
  }
</style>
